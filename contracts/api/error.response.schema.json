{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error body for 400, 401, 403, 404, 409, 429, 500, 501",
  "type": "object", "additionalProperties": false, "required": ["error", "message"],
  "properties": {
    "error": { "enum": ["BAD_REQUEST", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "CONFLICT", "THROTTLED", "NOT_IMPLEMENTED", "INTERNAL_ERROR"] },
    "message": { "type": "string", "maxLength": 300 },
    "requestId": { "type": "string" },
    "fields": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "message"],
        "properties": { "path": { "type": "string", "maxLength": 200 }, "message": { "type": "string", "maxLength": 200 } }
      }
    }
  }
}
