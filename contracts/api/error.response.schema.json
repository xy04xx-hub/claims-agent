{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error body for 400, 401, 403, 404, 409, 429",
  "type": "object", "additionalProperties": false, "required": ["error", "message"],
  "properties": { "error": { "enum": ["BAD_REQUEST", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "CONFLICT", "THROTTLED"] }, "message": { "type": "string", "maxLength": 300 }, "requestId": { "type": "string" } }
}
