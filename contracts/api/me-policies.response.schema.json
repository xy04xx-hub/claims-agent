{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /me/policies response",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policyId", "version", "items"],
        "properties": {
          "policyId": { "type": "string", "pattern": "^POL-[A-Za-z0-9-]{1,40}$" },
          "version": { "type": "integer", "minimum": 1 },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "category", "label", "causes"],
              "properties": {
                "itemId": { "type": "string", "maxLength": 40 },
                "category": { "type": "string", "maxLength": 40 },
                "label": { "type": "string", "maxLength": 100 },
                "causes": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["cause", "requiredEvidence"],
                    "properties": {
                      "cause": { "type": "string", "maxLength": 30 },
                      "requiredEvidence": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["kind", "description"],
                          "properties": {
                            "kind": { "enum": ["DEVICE_PHOTO", "POLICE_REPORT", "PLATE_PHOTO", "STATEMENT"] },
                            "description": { "type": "string", "maxLength": 200 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
