    "autoHandled": { "type": "integer", "minimum": 0 },
    "autoHandleRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "latencyMsP50": { "type": "number", "minimum": 0 },
    "latencyMsP95": { "type": "number", "minimum": 0 },
    "hoursSaved": { "type": "number", "minimum": 0 },
    "dollarsSaved": { "type": "number", "minimum": 0 } }
}
