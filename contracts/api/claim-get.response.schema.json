{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /claims/{claimId} response. Customer view hides internal signals. Adjuster view adds adjusterReasons, riskSignals, informationalFlags.",
  "type": "object", "additionalProperties": false, "required": ["claimId", "status", "createdAt"],
  "properties": {
      "claimId": { "type": "string", "pattern": "^CLM-[A-Za-z0-9-]{1,40}$" },
      "status": { "enum": ["PROCESSING", "AUTO_APPROVED", "ROUTED_TO_ADJUSTER", "APPROVED_BY_ADJUSTER", "REJECTED_BY_ADJUSTER"] },
      "policyId": { "type": "string" },
      "itemId": { "type": "string" },
      "cause": { "type": "string" },
      "amountClaimed": { "type": "number" },
      "lossDate": { "type": "string", "format": "date" },
      "createdAt": { "type": "string", "format": "date-time" },
      "decidedAt": { "type": "string", "format": "date-time" },
      "payout": { "type": "number", "minimum": 0 },
      "checksPassed": { "type": "array", "items": { "type": "string" } },
      "customerMessage": { "type": "string", "maxLength": 500 },
      "evidenceIds": { "type": "array", "maxItems": 6, "items": { "type": "string" } },
      "adjusterReasons": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
      "riskSignals": { "type": "array", "items": { "type": "string" } },
      "informationalFlags": { "type": "array", "items": { "type": "string" } } }
}
