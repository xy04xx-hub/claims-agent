{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /evidence/uploads request",
  "type": "object", "additionalProperties": false, "required": ["files"],
  "properties": { "files": { "type": "array", "minItems": 1, "maxItems": 6, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["name", "contentType", "sizeBytes", "kind"],
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 120 },
      "contentType": { "enum": ["image/jpeg", "image/png", "application/pdf"] },
      "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 5242880 },
      "kind": { "enum": ["DEVICE_PHOTO", "POLICE_REPORT", "PLATE_PHOTO", "STATEMENT"] } } } } }
}
