{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /evidence/uploads response (presigned POST per file)",
  "type": "object", "additionalProperties": false, "required": ["uploads"],
  "properties": { "uploads": { "type": "array", "minItems": 1, "maxItems": 6, "items": {
    "type": "object", "additionalProperties": false,
    "required": ["evidenceId", "url", "fields", "expiresAt"],
    "properties": {
      "evidenceId": { "type": "string", "pattern": "^EVD-[A-Za-z0-9-]{1,40}$" },
      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
      "fields": { "type": "object", "additionalProperties": { "type": "string" } },
      "expiresAt": { "type": "string", "format": "date-time" } } } } }
}
