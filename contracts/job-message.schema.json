{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SQS job message. IDs only, no personal data, no tokens.",
  "type": "object", "additionalProperties": false, "required": ["tenantId", "claimId", "attempt", "requestId"],
  "properties": {
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 40 },
    "claimId": { "type": "string", "pattern": "^CLM-[A-Za-z0-9-]{1,40}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 80 } }
}
